{
  "id": "/dashboard",
  "name": "COOPAECA - Panel de Control",
  "short_name": "COOPAECA",
  "description": "Gestión de contenidos, comercio, inventario y administración de COOPAECA.",
  "lang": "es-PE",
  "start_url": "/dashboard?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f4f7fb",
  "theme_color": "#004d2e",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/assets/icons/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Panel de control",
      "short_name": "Panel",
      "url": "/dashboard?source=pwa-shortcut",
      "icons": [{ "src": "/assets/icons/pwa-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Productos",
      "short_name": "Productos",
      "url": "/products?source=pwa-shortcut",
      "icons": [{ "src": "/assets/icons/pwa-192.png", "sizes": "192x192" }]
    }
  ]
}
